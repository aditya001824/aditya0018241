# Application Settings
APP_NAME=CyberIncidentResponse
APP_VERSION=0.1.0
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Elasticsearch Settings
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=cir_

# Ollama Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=300

# Detection Settings
ANOMALY_CONTAMINATION=0.1
ANOMALY_THRESHOLD=0.75
TSFRESH_N_JOBS=4

# Correlation Settings
CORRELATION_TIME_WINDOW=300
CORRELATION_MIN_SCORE=0.6

# Alert Settings
ALERT_RETENTION_DAYS=90
MAX_ALERTS_PER_QUERY=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
